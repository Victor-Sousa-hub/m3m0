# Copy to .env and fill in before `docker compose up -d`.

# Public domain Caddy will request a Let's Encrypt certificate for.
# Use "localhost" to test locally with a self-signed certificate instead.
DOMAIN=m3m0.example.com

# Contact email Let's Encrypt uses for certificate/expiry notices.
ACME_EMAIL=you@example.com

# Image published with `docker push` after building from the Dockerfile
# on the main branch (see README.md).
DOCKERHUB_IMAGE=<dockerhub-user>/m3m0-web
IMAGE_TAG=latest
