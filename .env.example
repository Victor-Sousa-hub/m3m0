# Copy to .env and fill in before `docker compose up -d`.

# Image published with `docker push` after building from the Dockerfile
# on the main branch (see README.md).
DOCKERHUB_IMAGE=<dockerhub-user>/m3m0-web
IMAGE_TAG=latest

# No DOMAIN/ACME_EMAIL here anymore — this container only serves plain
# HTTP internally on :80 (no published ports, no TLS). The public domain
# and Let's Encrypt certificate are configured once, for all projects, in
# the VPS edge proxy's .env (see /PROXY at the repo root: M3M0_DOMAIN).

# `edge_net` must exist before `docker compose up -d` (shared with the
# edge proxy and other projects — see /PROXY/README.md):
#   docker network create edge_net
